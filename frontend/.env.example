# Public configuration only. Never put credentials or JWT signing secrets in VITE_* values.
# Relative API path uses the Vite proxy during development.
VITE_API_BASE_URL=/api
# Server-side Vite setting; change this if the backend listens on another port.
API_PROXY_TARGET=http://127.0.0.1:8000
# Display currency only; the database does not store a currency per vehicle.
VITE_CURRENCY=INR
