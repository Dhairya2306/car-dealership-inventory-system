# Copy to .env locally. Empty secrets are intentional; supply your own values.
# Alternatively, app.local_database init generates .env safely; do not copy it first.
# Its dedicated local cluster uses port 55432; the manual/Compose defaults below use 5432.
POSTGRES_DB=dealership
POSTGRES_USER=dealership
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
# Use the same password as above, URL-encoded if it contains reserved characters.
# Render: set DATABASE_URL to the hosted URL in the dashboard; postgres:// and
# postgresql:// also work. POSTGRES_* above are local/Compose settings, not API requirements.
DATABASE_URL=postgresql+psycopg://dealership:REPLACE_WITH_YOUR_PASSWORD@localhost:5432/dealership
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_ISSUER=dealership-api
JWT_AUDIENCE=dealership-web
CORS_ORIGINS=["http://localhost:5173"]
# Production: replace CORS_ORIGINS with a JSON array of exact frontend HTTPS origins.
# Tests do not read this file. The isolated runner supplies TEST_DATABASE_URL itself.
