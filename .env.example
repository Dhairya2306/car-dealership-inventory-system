# Copy to .env locally. Empty secrets are intentional; supply your own values.
POSTGRES_DB=dealership
POSTGRES_USER=dealership
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
# Use the same password as above, URL-encoded if it contains reserved characters.
DATABASE_URL=postgresql+psycopg://dealership:REPLACE_WITH_YOUR_PASSWORD@localhost:5432/dealership
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=["http://localhost:5173"]
